<div class="row spread"><div><span class="badge <%= { Quoted: 'b-warn', Confirmed: 'b-info', Completed: 'b-ok', Cancelled: 'b-err' }[b.status] %>"><%= b.status %></span> <span class="badge <%= { Paid: 'b-ok', Overpaid: 'b-warn', Unpaid: 'b-err' }[b.pay_status] || '' %>"><%= b.pay_status %></span></div>
  <div class="row noprint"><a class="btn ghost sm" href="/app/bookings/<%= b.id %>/edit">Edit booking</a><button class="btn ghost sm" data-print>Print</button></div></div>
<div class="grid g2" style="align-items:start;margin-top:14px">
  <div class="card"><h2><%= b.ref %></h2>
    <dl class="kv">
      <dt>Customer</dt><dd><a href="/app/customers/<%= b.customer_id %>"><%= b.customer %></a> (<%= b.customer_code %>)</dd>
      <dt>Request</dt><dd><% if (request) { %><a href="/app/requests/<%= request.id %>"><%= request.ref %></a><% } else { %>—<% } %></dd>
      <dt>Service</dt><dd><%= b.service_type %></dd><dt>Supplier</dt><dd><%= b.supplier || '—' %></dd><dt>Confirmation / ticket ref</dt><dd><%= b.confirmation_ref || '—' %></dd>
      <dt>Assigned to</dt><dd><%= b.employee || '—' %></dd><dt>Created</dt><dd><%= b.created_at.slice(0, 16) %></dd>
    </dl>
    <% if (b.details) { %><h3 style="margin-top:14px">Details</h3><p style="white-space:pre-line"><%= b.details %></p><% } %>
    <% if (b.remarks) { %><h3>Remarks</h3><p style="white-space:pre-line"><%= b.remarks %></p><% } %></div>
  <div class="card"><h3>Money</h3>
    <dl class="kv"><dt>Selling price</dt><dd><%= U.peso(b.selling_price) %></dd><dt>Service fee</dt><dd><%= U.peso(b.service_fee) %></dd><dt>Discount</dt><dd>−<%= U.peso(b.discount) %></dd>
    <dt>Total payable</dt><dd><strong><%= U.peso(b.total) %></strong></dd><dt>Payments received (net)</dt><dd><%= U.peso(b.paid) %></dd>
    <dt>Outstanding balance</dt><dd><strong style="color:<%= b.balance ? 'var(--err)' : 'var(--ok)' %>"><%= U.peso(b.balance) %></strong></dd>
    <dt>Supplier cost</dt><dd><%= U.peso(b.supplier_cost) %></dd><dt>Gross margin</dt><dd><%= U.peso(b.margin) %></dd></dl></div>
</div>

<div class="card"><h3>Payments &amp; refunds</h3>
  <div class="tw"><table><thead><tr><th>ID</th><th>Date</th><th>Type</th><th>Method</th><th>Reference</th><th class="num">Amount</th><th>By</th><th>Remarks</th><th></th></tr></thead><tbody>
    <% payments.forEach(function (p) { %><tr class="<%= p.status === 'Reversed' ? 'off' : '' %>"><td><%= p.ref %></td><td><%= p.paid_at %></td><td><%= p.kind %><%= p.status === 'Reversed' ? ' — REVERSED' : '' %></td><td><%= p.method %></td><td><%= p.reference %></td>
      <td class="num"><%= p.kind === 'Refund' ? '−' : '' %><%= U.peso(p.amount) %></td><td><%= p.recorder %></td><td><%= p.status === 'Reversed' ? 'Reversed: ' + p.reversed_reason : p.remarks %></td>
      <td><% if (me.role === 'owner' && p.status === 'Valid') { %><form method="post" action="/app/payments/<%= p.id %>/reverse" class="row noprint"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" placeholder="Reason" required maxlength="500" style="width:130px"><button class="btn danger sm" data-confirm="Reverse this record? It will stop counting in totals.">Reverse</button></form><% } %></td></tr><% }) %>
    <% if (!payments.length) { %><tr><td colspan="9" class="empty">No payments recorded.</td></tr><% } %></tbody></table></div>
  <form method="post" action="/app/bookings/<%= b.id %>/payment" class="noprint" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>Record payment or refund</h3>
    <div class="grid g4">
      <div class="field"><label>Type</label><select name="kind"><option>Payment</option><option>Refund</option></select></div>
      <div class="field"><label>Amount (₱) *</label><input name="amount" type="number" step="0.01" min="0.01" required></div>
      <div class="field"><label>Date *</label><input name="paid_at" type="date" value="<%= U.today() %>" max="<%= U.today() %>" required></div>
      <div class="field"><label>Method *</label><select name="method" required><% B.METHODS.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
    </div>
    <div class="grid g2"><div class="field"><label>Reference no.</label><input name="reference" maxlength="80"></div><div class="field"><label>Remarks</label><input name="remarks" maxlength="500"></div></div>
    <button class="btn">Record</button> <span class="muted small">Records cannot be deleted; mistakes are reversed by the owner with a reason.</span>
  </form>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card"><h3>Supporting documents</h3>
    <ul class="timeline"><% docs.forEach(function (d) { %><li><a href="/app/files/doc/<%= d.id %>"><%= d.original %></a><div class="small muted"><%= d.uploader %> · <%= d.at.slice(0, 16) %></div></li><% }) %><% if (!docs.length) { %><li class="muted small">No documents.</li><% } %></ul>
    <form method="post" enctype="multipart/form-data" action="/app/bookings/<%= b.id %>/upload?_csrf=<%= csrf %>" class="noprint"><input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required><p class="small muted">PDF, JPG, PNG or Word · max 5 MB</p><button class="btn sm">Upload</button></form></div>
  <%- include('../partials/notes', { entity: 'booking', id: b.id, notes }) %>
</div>
