<section class="section"><div class="wrap"><div class="formbox" style="margin-top:0">
  <h1>Request Travel Assistance</h1>
  <div class="notice">This form sends a request to our staff. <strong>It does not book or pay for anything.</strong> We will contact you with options and a quotation before anything is booked.</div>
  <% if (Object.keys(errors).length) { %><div class="flash err" role="alert">Please fix the highlighted fields.</div><% } %>
  <form method="post" action="/request" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="hp" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>
    <div class="card" style="margin-top:18px"><h2>Your details</h2>
      <div class="grid g2">
        <%- include('../partials/field', { name: 'name', label: 'Full name *', v, errors, attrs: 'required maxlength="120" autocomplete="name"' }) %>
        <%- include('../partials/field', { name: 'phone', label: 'Contact number *', type: 'tel', v, errors, attrs: 'required maxlength="20" autocomplete="tel"' }) %>
        <%- include('../partials/field', { name: 'email', label: 'Email address *', type: 'email', v, errors, attrs: 'required maxlength="160" autocomplete="email"' }) %>
        <%- include('../partials/field', { name: 'pref_contact', label: 'Preferred contact method *', type: 'select', options: ['Phone call', 'SMS', 'Email', 'Viber', 'Messenger', 'WhatsApp'], v, errors, attrs: 'required' }) %>
      </div>
    </div>
    <div class="card"><h2>What do you need?</h2>
      <%- include('../partials/field', { name: 'service_type', label: 'Service *', type: 'select', options: B.SERVICE_TYPES, v, errors, attrs: 'required' }) %>
      <% Object.entries(forms.GROUPS).forEach(function (g) { %>
        <div data-types="<%= g[1].types.join('|') %>" hidden>
          <div class="grid g2">
          <% g[1].fields.forEach(function (f) {
               const w = f.when ? ' data-when-trip="' + f.when + '"' : '';
               const attrs = (f.required ? 'required ' : '') + (f.min != null ? 'min="' + f.min + '" ' : '') + (f.max != null ? 'max="' + f.max + '" ' : '') + 'disabled';
               const wide = f.type === 'textarea' ? 'style="grid-column:1/-1"' : ''; %>
            <div <%- w %> <%- wide %>>
              <%- include('../partials/field', { name: 'd_' + f.k, label: f.label + (f.required ? ' *' : ''), type: f.type, options: f.options || [], v, errors: Object.fromEntries(Object.entries(errors).map(function (x) { return ['d_' + x[0], x[1]]; })), attrs }) %>
            </div>
          <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="card">
      <div class="field <%= errors.consent ? 'has-err' : '' %>"><label style="font-weight:500"><input type="checkbox" name="consent" <%= v.consent ? 'checked' : '' %>> I have read and agree to the <a href="/privacy" target="_blank">privacy notice</a> and consent to my details being used to process this request. *</label>
      <% if (errors.consent) { %><div class="err"><%= errors.consent %></div><% } %></div>
      <button class="btn alt big">Submit request</button>
    </div>
  </form>
</div></div></section>
