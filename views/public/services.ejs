<section class="section"><div class="wrap">
  <h1>Our Services</h1>
  <p class="muted">All services are arranged by our staff on your behalf. Submit a request and we will get back to you with options and a quotation.</p>
  <div class="cards">
    <% services.forEach(function (s) { %>
      <div class="svc"><div class="ic" aria-hidden="true"><%= s.icon %></div><h3><%= s.name %></h3><p class="muted"><%= s.description %></p>
      <a class="btn" href="/request?service=<%= encodeURIComponent(s.type) %>">Request assistance</a></div>
    <% }) %>
  </div>
</div></section>
